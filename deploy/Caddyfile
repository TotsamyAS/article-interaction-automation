{
    # Browsers/curl do not send an SNI hostname for a literal IP address.
    # Use the managed IP certificate as the default for non-SNI TLS clients.
    default_sni {$APP_PUBLIC_IP}
}

https://{$APP_PUBLIC_IP} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode zstd gzip
    reverse_proxy frontend:3033
}
